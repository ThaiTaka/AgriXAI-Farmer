+    /**
+     * AgriLog patch: with the activity paused (app in the background but not
+     * terminated) React Native stops driving JS timers, so a handler that
+     * awaits fetch() or setTimeout never finishes until the app is reopened.
+     * A headless JS task keeps timers running, so in that state the event is
+     * delivered to the registered headless task ("BackgroundFetch") instead.
+     * In the foreground the event goes to the configure() listener as before.
+     */
+    private void deliver(final String taskId, final boolean timeout) {
+        final ReactApplicationContext context = getReactApplicationContext();
+        if (context.getLifecycleState() == LifecycleState.RESUMED || !context.hasActiveReactInstance()) {
+            context.getJSModule(RCTNativeAppEventEmitter.class).emit(EVENT_FETCH, eventParams(taskId, timeout));
+            return;
+        }
+        UiThreadUtil.runOnUiThread(() -> {
+            try {
+                HeadlessJsTaskContext.getInstance(context)
+                        .startTask(new HeadlessJsTaskConfig("BackgroundFetch", eventParams(taskId, timeout), 30000));
+            } catch (IllegalStateException e) {
+                context.getJSModule(RCTNativeAppEventEmitter.class).emit(EVENT_FETCH, eventParams(taskId, timeout));
+            }
+        });
+    }

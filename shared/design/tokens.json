  "shadow": {
    "$note": "Two shadows, both light. Nothing darker than these anywhere in the app.",
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "md": "0 4px 6px rgba(0,0,0,0.10)"
  },
  "radius": {
    "xs": 6,
    "sm": 10,
    "md": 14,
    "lg": 18,
    "xl": 24,
    "pill": 999
  },
  "space": {
    "$note": "8pt grid. xs/md are the two half-steps the grid allows for tight inner spacing.",
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 40,
    "4xl": 48
  },

# ---------------------------------------------------------------
# AgriLog v2 — biến môi trường cho PRODUCTION
#
# Chép thành biến môi trường trên máy chủ (Render / Railway / VPS).
# KHÔNG commit file đã điền giá trị thật.
#
# API sẽ TỪ CHỐI khởi động nếu ENVIRONMENT=production mà còn dùng khoá dev,
# còn trỏ vào SQLite, hoặc DEBUG=true. Đó là cố ý: ba lỗi này đều im lặng cho
# tới lúc trả giá đắt.
# ---------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL 14+ (đã kiểm thử trên 16). Dùng driver psycopg 3.
DATABASE_URL=postgresql+psycopg://agrilog:MAT_KHAU_THAT@db-host:5432/agrilog

# Pool kết nối. Quy tắc bắt buộc:
#   SỐ_WORKER × (DB_POOL_SIZE + DB_MAX_OVERFLOW) < max_connections của PostgreSQL
# Ví dụ 4 worker, max_connections=100 -> mỗi worker tối đa 25 kết nối.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
# Ngắt kết nối trước khi nhà cung cấp tự cắt (thường 5–10 phút).
DB_POOL_RECYCLE=280

# BẮT BUỘC đổi. Sinh khoá:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Đổi khoá này sẽ vô hiệu hoá mọi token đang dùng — nông hộ phải đăng nhập lại.
SECRET_KEY=THAY_BANG_KHOA_NGAU_NHIEN_48_KY_TU

# 7 ngày. Ngắn hơn nghĩa là bắt nông hộ đăng nhập lại giữa đồng, nơi không có
# sóng — rủi ro token dài hạn được bù bằng việc khoá tài khoản ở /users/{id}/status
# có hiệu lực ngay ở yêu cầu kế tiếp (mọi request đều kiểm tra tài khoản trong DB).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=60
LOGIN_LOCKOUT_SECONDS=60

SLOW_REQUEST_MS=1000

# Chỉ liệt kê tên miền thật. Không dùng "*" — API dùng token trong header nên
# một origin lạ đọc được phản hồi là đọc được dữ liệu nông hộ.
CORS_ORIGINS=https://agrilog.example.com

# Không seed tài khoản demo trên production. Tạo tài khoản quản trị đầu tiên
# bằng tay, rồi dùng POST /users để tạo tài khoản nông hộ.

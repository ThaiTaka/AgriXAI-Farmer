# ---------------------------------------------------------------
# AgriLog v2 — backend environment
# Copy to `.env` and adjust. `.env` is git-ignored.
# Bản dành cho production: xem `.env.production.example`.
# ---------------------------------------------------------------

# development | staging | production.
# Ở "production" API từ chối khởi động nếu còn dùng khoá dev, còn dùng SQLite,
# hoặc DEBUG=true — xem app/main.py::guard_production.
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Dev default is a local SQLite file. For production, switch to PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://agrilog:password@localhost:5432/agrilog
DATABASE_URL=sqlite:///./agrilog.db

# Kích thước pool kết nối (chỉ áp dụng cho PostgreSQL).
# Quy tắc: SỐ_WORKER × (DB_POOL_SIZE + DB_MAX_OVERFLOW) phải nhỏ hơn
# max_connections của PostgreSQL (mặc định 100).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=280

# CHANGE THIS before deploying anywhere reachable.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
# 7 ngày. Nông hộ có thể ở ngoài vùng sóng nhiều ngày liền; token ngắn hơn
# đồng nghĩa với việc bắt họ đăng nhập lại ở giữa đồng, nơi không có mạng.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Chặn dò mật khẩu ở POST /auth/login. Chỉ lần sai mới bị đếm. 0 = tắt.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=60
LOGIN_LOCKOUT_SECONDS=60

# Yêu cầu chậm hơn ngưỡng này (ms) sẽ được ghi log WARNING.
SLOW_REQUEST_MS=1000

# CORS origins allowed to call the API (web-admin dev server, Metro, emulator).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed accounts created by `python -m app.seed` (dev/demo only).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_FARMER_USERNAME=thaitaka
SEED_FARMER_PASSWORD=matkhau123

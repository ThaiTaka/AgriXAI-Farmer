# ---------------------------------------------------------------
# AgriLog v2 — backend environment
# Copy to `.env` and adjust. `.env` is git-ignored.
# ---------------------------------------------------------------

# Dev default is a local SQLite file. For production, switch to PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://agrilog:password@localhost:5432/agrilog
DATABASE_URL=sqlite:///./agrilog.db

# CHANGE THIS before deploying anywhere reachable.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS origins allowed to call the API (web-admin dev server, Metro, emulator).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where uploaded diagnosis photos are stored.
UPLOAD_DIR=./uploads

# AI diagnosis model. Empty => DummyPredictor. Point at a real checkpoint later.
MODEL_CHECKPOINT=

# Seed accounts created by `python -m app.seed` (dev/demo only).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_FARMER_USERNAME=thaitaka
SEED_FARMER_PASSWORD=matkhau123
